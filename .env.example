# Copy applicable values into the Vercel project environment variables.
# For local development, use backend/.env and frontend/.env.local instead.
# Never put real secrets in this file or commit them.

# --- Frontend (Vite) ---
# Leave empty so the browser calls same-origin /api/v1 through Vercel Services.
# Set only if the API is hosted on a different origin.
VITE_API_BASE_URL=

# --- Backend (FastAPI) ---
# Required in Vercel. Set a long, unique random value in Vercel's dashboard.
JWT_SECRET=

# Required for persistent production data. Use a managed PostgreSQL URL.
# SQLite is for local development; Vercel's function filesystem is ephemeral.
DATABASE_URL=

# Optional JWT tuning
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# The current frontend always submits a mock credential. The backend accepts
# it only when GOOGLE_CLIENT_ID is empty; setting a real ID alone will make
# sign-in fail until a real frontend OAuth flow is implemented. Do not expose
# the current mock-login flow as public production authentication.
GOOGLE_CLIENT_ID=
# Present in settings but not currently used by the backend's ID-token check.
GOOGLE_CLIENT_SECRET=
# Settings-only at present; no backend redirect callback consumes this value.
GOOGLE_REDIRECT_URI=

# Optional. If empty, the in-process template QA engine is used; no Ollama/local model.
GEMINI_API_KEY=

# Extra browser origins (comma-separated). Same-origin Vercel routing does not
# require this. Use only for a separately hosted frontend or local tools.
CORS_ORIGINS=

# Optional storage overrides. On Vercel, local storage is under /tmp/autodoc
# and is not persistent across invocations. The application currently has no
# object-storage integration, so uploaded archives and extracted files are ephemeral.
# UPLOAD_DIR=
# TEMP_DIR=
# REPORT_DIR=
